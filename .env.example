# ============================================================
# 配置示例（公开版）
# 用法一：复制本文件为 .env，填入你自己的密钥。
# 用法二（推荐）：启动 Web 界面后，点右上角「设置」，
#          直接在界面里填写 Base URL / API Key / 模型，即填即用。
#
# 注意：.env 与 runtime_settings.json 均已加入 .gitignore，
#       不会随代码提交到公开仓库。
# ============================================================

NOVEL_BASE_URL=https://api.openai.com/v1
NOVEL_API_KEY=
NOVEL_MODEL=gpt-4o-mini
NOVEL_TIMEOUT=600
NOVEL_MAX_RETRIES=3
